iseur.\nVerifier les cretes TX et la tenue du 3V3 sur banc.\nRF : liaison 50 ohms courte et plan de masse lors du futur PCB." (at 15 170 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "51de570d-ded2-4f71-a7d8-71f86ab72190")) (symbol (lib_id "Collier:R") (at 229.86999999999998 134.62 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "29b4d684-b64b-47c8-9820-72d637621a1c") (property "Reference" "R8" (at 232.86999999999998 131.62 0) (effects (font (size 1.1 1.1)) (justify left))) (property "Value" "1M" (at 232.86999999999998 134.62 0) (effects (font (size 1.1 1.1)) (justify left))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 229.86999999999998 134.62 0) (effects (font (size 1.1 1.1)) (justify left) (hide yes))) (property "Datasheet" "~" (at 229.86999999999998 134.62 0) (effects (font (size 1.1 1.1)) (justify left) (hide yes))) (pin "1" (uuid "d81f2757-c08c-4893-a2d3-20dab6eae781")) (pin "2" (uuid "2364c51e-732c-4670-a494-81e7a66cd229")) (instances (project "collier_chien" (path "/7b09fa79-7372-4685-ba42-4de3750bbcc2/92d73413-1739-4547-a5e4-aca8d0cf0eff" (reference "R8") (unit 1))))) (symbol (lib_id "Collier:R") (at 229.86999999999998 154.94 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "106411c7-f9cf-437c-b1d3-b994a6fea108") (property "Reference" "R9" (at 232.86999999999998 151.94 0) (effects (font (size 1.1 1.1)) (justify left))) (property "Value" "2M" (at 232.86999999999998 154.94 0) (effects (font (size 1.1 1.1)) (justify left))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 229.86999999999998 154.94 0) (effects (font (size 1.1 1.1)) (justify left) (hide yes))) (property "Datasheet" "~" (at 229.86999999999998 154.94 0) (effects (font (size 1.1 1.1)) (justify left) (hide yes))) (pin "1" (uuid "8f36f6a8-688e-450a-8826-37fe07706c3d")) (pin "2" (uuid "10af42ee-5a18-42bf-a5cf-3efee20e85d3")) (instances (project "collier_chien" (path "/7b09fa79-7372-4685-ba42-4de3750bbcc2/92d73413-1739-4547-a5e4-aca8d0cf0eff" (referen