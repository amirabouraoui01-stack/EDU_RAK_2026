) (dnp no) (uuid "d0dcb61b-0399-4be8-b2e3-14d8457def5c") (property "Reference" "C11" (at 105.41 49.53 0) (effects (font (size 1.1 1.1)) (justify left))) (property "Value" "100nF" (at 105.41 53.34 0) (effects (font (size 1.1 1.1)) (justify left))) (property "Footprint" "Capacitor_SMD:C_0603_1608Metric" (at 105.41 64.77 0) (effects (font (size 1.1 1.1)) (justify left) (hide yes))) (property "Datasheet" "https://www.pololu.com/product/3692" (at 105.41 64.77 0) (effects (font (size 1.1 1.1)) (justify left) (hide yes))) (pin "1" (uuid "f613182f-394b-4195-a6b6-81488ad208dd")) (pin "2" (uuid "ba62dcca-92f8-4ee5-96f6-dd36d83fef13")) (instances (project "veilleporte" (path "/7b09fa79-7372-4685-ba42-4de3750bbcc2/4afee4ae-6178-42ec-aa33-005394e84bff" (reference "C11") (unit 1))))) (wire (pts (xy 144.78 60.96) (xy 144.78 53.34)) (stroke (width 0) (type default)) (uuid "fd73d5f0-7212-497a-919f-ec86ed64a23d")) (global_label "PWR" (shape bidirectional) (at 144.78 53.34 0) (effects (font (size 1 1)) (justify left)) (uuid "19d3b8b8-8b00-4b8a-89bf-ed090a6c1eb2") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 144.78 53.34 0) (effects (font (size 1 1)) (hide yes)))) (wire (pts (xy 144.78 68.58) (xy 144.78 76.2)) (stroke (width 0) (type default)) (uuid "5576dd1c-4d0e-40cd-b0cf-412ca862b9f2")) (global_label "GND" (shape bidirectional) (at 144.78 76.2 0) (effects (font (size 1 1)) (justify left)) (uuid "2ac029e2-c868-48e7-8321-55242edf861a") (property "Intersheetrefs" "${INTERSHEET_REFS}" (at 144.78 76.2 0) (effects (font (size 1 1)) (hide yes)))) (symbol (lib_id "Device:C") (at 144.78 64.77 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "71aa15ff-214e-4016-af9b-3e8d94ab8b43") (property "Reference" "C13" (at 139.7 49.53 0) (effects (font (size 1.1 1.1)) (justify left))) (property "Value" "10uF" (at 139.7 53.34 0) (effects (font (size 1.1 1.1)) (justify left))) (property "Footprint" "Capacitor_SMD:C_0603_1608Metric" (at 139.7 64.77 0) (effects (font (size 1.1 1.1)) (justify left) (hide yes))) (property "Datasheet" "https://www.pololu.com/product/3692" (at 139.7 64.77 0) (effects (font (size 1.1 1.1)) (justify left) (hide yes))) (pin "1" (uuid "1db5a6e1-bd94-42f8-8780-3e10929a2c5f")) (pin "2" (uuid "2b2b8597-aa6a-4c62-a35f-b80e639ad334")) (instances (project "veilleporte" (path "/7b09fa79-7372-4685-ba42-4de3750bbcc2/4afee4ae-6178-42ec-aa33-005394e84bff" (reference "C13") (unit 1))))) (text "J23 = brochage du cable de ce projet, PAS ordre des pastilles du module.\n1 -> VIN ; 2 -> GND ; 3 -> SDA ; 4 -> SCL ; 5 -> NON CONNECTE ; 6 -> GPIO1 ; 7 -> XSHUT.\nVerifier les noms serigraphies sur le module avant branchement.\nVDD du module reste non connecte ; ne jamais le relier a PWR." (at 20.32 105.41 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "d200bce6-fb72-4a0a-b90c-b90189530f43")) (text "I2C : adaptation et resistances de rappel deja presentes sur le module.\nPas de R12/R13 externes sur cette revision. Adresse I2C 7 bits : 0x29.\nGPIO1 2.8V -> PA1 directement ; Q1 et R14 supprimes.\nGPIO1 est rappele sur le module : PA1 en entree sans rappel interne.\nXSHUT -> PB5 : sortie drain ouvert, niveau bas ou haute impedance uniquement.\nNe pas activer de rappel interne a PWR sur XSHUT.\nLaisser le module alimente pendant son mode autonome ULP ; XSHUT bas l arrete." (at 20.32 139.7 0) (effects (font (size 1.2 1.2)) (justify left top)) (uuid "d69ea080-6940-46f7-8eba-02b33ac9e98f")) (text "La consommation ULP annoncee du capteur ne vaut pas pour toute la carte.\nPWR ~3.118V. Mesurer les pointes du module et de la radio avec le BQ25570.\nCible proche = porte fermee ; distance elevee ou absence de cible a qualifier.\nUne mesure invalide ne prouve pas une ouverture : prevoir un etat inconnu." (at 20.32 177.8 0) (effects (font (size 1.1 1.1)) (justify left top)) (uuid "c73f0ca6-a1fc-462e-b516-98712e89fe8f")) (no_connect (at 59.69 67.31) (uuid "534cca55-dc08-4ccd-8763-c1b209fba859")) (wire (pts (xy 59.69 69.85) (xy 52.07 69.85)) (stroke (width 0) (type default)) (uuid "b8a15c2c-a892-46ef-b52d-55570d5ae955")) (global_label "IR_INT" (shape input) (at 52.07 69.85 180) (effects (font (size 1 1)) (justify right)) (uuid "24792924-d886-4277-8514-b9b37a46f5ba")))
