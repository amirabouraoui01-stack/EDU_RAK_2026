ft bottom)) (uuid "5c117a18-e95d-4226-b723-ff54b7ef76ff")) (label "GND" (at 527.05 30.48 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "963d4682-5318-442c-a690-0977177f2113")) (sheet_instances (path "/" (page "1"))))
